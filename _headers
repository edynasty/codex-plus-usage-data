/data/latest.json
  Cache-Control: no-cache, max-age=0
/data/resets.json
  Cache-Control: no-cache, max-age=0
/data/context.json
  Cache-Control: no-cache, max-age=0
/data/current/*
  Cache-Control: no-cache, max-age=0, must-revalidate
/assets/*
  Cache-Control: no-cache, max-age=0, must-revalidate
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
